# Copy this file to ".env" (same folder) and fill in what you have.
# Both keys are optional. The board works with neither.
# .env is ignored by git, so your keys never get uploaded.

# Odds from many sportsbooks (free tier: https://the-odds-api.com). The board
# budgets its calls to stay inside the free 500 credits a month.
ODDS_API_KEY=

# Optional, costs money: lets Claude read the news (https://console.anthropic.com).
# Leave empty to keep the project free.
ANTHROPIC_API_KEY=
